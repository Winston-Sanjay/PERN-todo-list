# Ignore node modules everywhere
**/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files
.env
.env.*.local

# Build outputs
/build/

# OS files
.DS_Store

# Editor directories and files
.vscode/
*.code-workspace

# Ignore client internal git backup and any nested git dirs
client/.git_backup/
**/.git/
